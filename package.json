{
  "name": "yatagarasu",
  "version": "0.1.0",
  "private": true,
  "description": "Yatagarasu monorepo — native package manager frontends for macOS, Linux, and Windows",
  "scripts": {
    "build": "turbo run build",
    "build:macos": "turbo run build --filter=@yatagarasu/macos",
    "package:macos": "turbo run package --filter=@yatagarasu/macos",
    "install:macos": "pnpm --filter @yatagarasu/macos run install-app",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "pnpm@12.4.1"
}
