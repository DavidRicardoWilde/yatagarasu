{
  "name": "yatagarasu",
  "version": "0.1.0",
  "private": true,
  "description": "Yatagarasu monorepo — native package manager frontends for macOS, Linux, and Windows",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:macos": "turbo run build --filter=@yatagarasu/macos",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2"
  },
  "packageManager": "npm@10"
}
