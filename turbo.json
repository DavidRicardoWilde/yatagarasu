{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": true
    },
    "package": {
      "outputs": [
        "dist/**"
      ],
      "passThroughEnv": [
        "YATAGARASU_*",
        "DEVELOPER_DIR"
      ],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
